[Unit]
Description=Generates a Wireless Access Point when a valid SSID is not in range
Wants=canpi-ssr.service
Wants=pigpiod.service
After=network-online.target
After=pigpiod.service
Before=canpi-ssr.service

[Service]
Type=oneshot
WorkingDirectory=/usr/local/etc/hotspot
Environment="HTSPT_HOME=/usr/local/etc/hotspot"
Environment="HTSPT_INI_FILE=/usr/local/etc/hotspot/hotspot.cfg"
ExecStart=/usr/local/bin/autowapctl start
ExecStop=/usr/local/bin/autowapctl stop
ExecReload=/usr/local/bin/autowapctl restart
RemainAfterExit=yes

[Install]
WantedBy=network-online.target
